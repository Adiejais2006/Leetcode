1class Solution {
2    bool bfs(queue<pair<int, int>>& q, vector<int>& vis, vector<int>& colorNode,
3             vector<vector<int>>&graph) {
4        while (!q.empty()) {
5            auto [node, color] = q.front();
6            q.pop();
7            for (auto it : graph[node]) {
8                if (!vis[it]) {
9                    colorNode[it] = !color;
10                    vis[it] = 1;
11                    q.push({it, !color});
12                } else {
13                    if (colorNode[it] == color)
14                        return false;
15                }
16            }
17        }
18        return true;
19    }
20
21public:
22    bool isBipartite(vector<vector<int>>& graph) {
23        int n = graph.size();
24        vector<int> vis(n, 0);
25        vector<int> colorNode(n, -1);
26        queue<pair<int, int>> q;
27
28        for (int i = 0; i < n; i++) {
29            if (!vis[i]) {
30                q.push({i, 1});
31                vis[i] = 1;
32                colorNode[i] = 1;
33                if (!bfs(q, vis, colorNode,graph))
34                    return false;
35            }
36        }
37        return true;
38    }
39};