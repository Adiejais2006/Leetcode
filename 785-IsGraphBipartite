1class Solution {
2public:
3    bool isBipartite(vector<vector<int>>& graph) {
4        int n = graph.size();
5        vector<int> color(n, -1);
6        for (int i = 0; i < n; i++) {
7            if(color[i]!=-1) continue;
8            color[i] = 0;
9            queue<int> q;
10            q.push(i);
11            while (!q.empty()) {
12                auto node = q.front();
13                q.pop();
14                for (auto it : graph[node]) {
15                    if (color[it] == -1) {
16                        color[it] = 1 - color[node];
17                        q.push(it);
18                    } else {
19                        if (color[it] == color[node])
20                            return false;
21                    }
22                }
23            }
24        }
25        return true;
26    }
27};